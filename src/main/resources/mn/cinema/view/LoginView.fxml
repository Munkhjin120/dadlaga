<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="14.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mn.cinema.controller.LoginController">
    <padding>
        <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
    </padding>

    <Label styleClass="title-label" text="Кино театр ба тоглолтын тасалбар" wrapText="true" />
    <Label styleClass="subtitle-label" text="Нэвтрэх" />

    <VBox spacing="6.0">
        <Label text="Хэрэглэгчийн нэр" />
        <TextField fx:id="usernameField" promptText="Хэрэглэгчийн нэр" />
    </VBox>

    <VBox spacing="6.0">
        <Label text="Нууц үг" />
        <PasswordField fx:id="passwordField" promptText="Нууц үг" onAction="#handleLogin" />
    </VBox>

    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" />

    <Button fx:id="loginButton" defaultButton="true" maxWidth="Infinity" onAction="#handleLogin" styleClass="primary-button" text="Нэвтрэх" />

    <HBox alignment="CENTER" spacing="4.0">
        <Label text="Бүртгэлгүй юу?" />
        <Hyperlink fx:id="registerLink" onAction="#handleGoToRegister" text="Бүртгүүлэх" />
    </HBox>
</VBox>
