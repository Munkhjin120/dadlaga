<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mn.cinema.controller.EventListController">
    <padding>
        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
    </padding>

    <Label styleClass="section-title" text="Одоо болон удахгүй болох кино, тоглолтууд" />

    <TableView fx:id="eventTable" VBox.vgrow="ALWAYS" prefHeight="320.0">
        <columns>
            <TableColumn fx:id="typeColumn" text="Төрөл" prefWidth="80.0" />
            <TableColumn fx:id="titleColumn" text="Нэр" prefWidth="240.0" />
            <TableColumn fx:id="dateColumn" text="Огноо" prefWidth="100.0" />
            <TableColumn fx:id="timeColumn" text="Цаг" prefWidth="70.0" />
            <TableColumn fx:id="hallColumn" text="Танхим" prefWidth="140.0" />
            <TableColumn fx:id="priceColumn" text="Үнэ" prefWidth="90.0" />
        </columns>
    </TableView>

    <Label text="Тайлбар" />
    <TextArea fx:id="descriptionArea" editable="false" prefHeight="90.0" wrapText="true" />

    <Button fx:id="selectButton" onAction="#handleSelectEvent" styleClass="primary-button" text="Суудал сонгох" />
</VBox>
